# MindWatch 2.0 — Environment Configuration Example
# Copy this file to .env and configure values as needed.

# Flask secret key (auto-generated in development if left empty)
SECRET_KEY=

# Server Port (default: 5000)
PORT=5000

# SQLite Database path override (defaults to app/mindwatch.db)
# MINDWATCH_DB=app/mindwatch.db

# Privacy Control: Raw text is NEVER stored by default (0).
# Set to 1 only if explicit persistence of raw text inputs is consented and required.
MINDWATCH_STORE_TEXT=0

# Set to 1 in production behind HTTPS to enforce Secure cookies
MINDWATCH_HTTPS=0

# ----------------------------------------------------------------------
# Optional LLM API Integrations for Context-Aware Support Chat
# ----------------------------------------------------------------------
# If configured, the supportive chat uses Gemini 2.5 Flash / 1.5 Flash or OpenAI.
# If left empty, MindWatch automatically uses its built-in, multi-turn local
# conversational engine with topic detection and evidence-based coping exercises.
GEMINI_API_KEY=
OPENAI_API_KEY=
